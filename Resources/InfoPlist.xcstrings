{
  "sourceLanguage": "en",
  "strings": {
    "NSDesktopFolderUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shelf liest die Dateien, die du aus deinem Schreibtischordner kopierst, um eine Vorschau zu zeigen und sie wieder einzusetzen. Sonst liest es dort nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shelf reads the files you copy from your Desktop folder, to show a preview and paste them back. It reads nothing else there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Shelf lee los archivos que copias de tu carpeta Escritorio para mostrar una vista previa y volver a pegarlos. No lee nada más allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Shelf lit les fichiers que vous copiez depuis votre dossier Bureau, pour en afficher un aperçu et les recoller. Il n'y lit rien d'autre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Shelfは、デスクトップフォルダからコピーしたファイルを読み込み、プレビューの表示と再ペーストに使います。それ以外は読み込みません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Shelf leest de bestanden die je uit je bureaubladmap kopieert, om een voorvertoning te tonen en ze terug te plakken. Verder leest het daar niets."
          }
        }
      }
    },
