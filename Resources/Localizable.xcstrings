{
  "sourceLanguage": "en",
  "strings": {
    "%@ (if its clipboard history is on)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (wenn der Zwischenablageverlauf aktiviert ist)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (si su historial del portapapeles está activado)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (si son historique du presse-papiers est activé)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（クリップボード履歴がオンの場合）"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (als de klembordgeschiedenis aanstaat)"
