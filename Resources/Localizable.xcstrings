    "Stays on your Mac, encrypted, and skips passwords.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt verschlüsselt auf deinem Mac und überspringt Passwörter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se queda en tu Mac, cifrado, y omite las contraseñas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste sur votre Mac, chiffré, et ignore les mots de passe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの中だけに暗号化して保存し、パスワードは記録しません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijft versleuteld op je Mac en slaat wachtwoorden over."
          }
        }
      }
    },
