          }
        }
      }
    },
    "Copies the last crash log to the clipboard and opens a new GitHub issue. Crash logs never contain clipboard content. Nothing is sent unless you submit the issue.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert das letzte Absturzprotokoll in die Zwischenablage und öffnet ein neues GitHub-Issue. Absturzprotokolle enthalten nie Inhalte der Zwischenablage. Es wird nichts gesendet, solange das Issue nicht abgeschickt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia el último registro de fallos en el portapapeles y abre una nueva incidencia en GitHub. Los registros de fallos nunca incluyen contenido del portapapeles. No se envía nada a menos que envíes la incidencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie le dernier rapport de plantage dans le presse-papiers et ouvre un nouveau ticket GitHub. Les rapports de plantage ne contiennent jamais le contenu du presse-papiers. Rien n'est envoyé tant que vous n'avez pas soumis le ticket."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新のクラッシュログをクリップボードにコピーし、GitHubで新しいIssueを開きます。クラッシュログにクリップボードの内容が含まれることはありません。Issueを送信しない限り、何も送信されません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieert het laatste crashlog naar het klembord en opent een nieuw issue op GitHub. Crashlogs bevatten nooit klembordinhoud. Er wordt niets verstuurd tenzij je het issue indient."
          }
        }
      }
    },
