    "A column of cards up the screen edge. ↑ and ↓ move between cards.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Spalte mit Karten am Bildschirmrand. ↑ und ↓ wechseln zwischen den Karten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una columna de tarjetas junto al borde de la pantalla. ↑ y ↓ se mueven entre tarjetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une colonne de cartes le long du bord de l'écran. ↑ et ↓ passent d'une carte à l'autre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の端に沿ってカードを縦に並べます。↑と↓でカード間を移動します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een kolom kaarten langs de schermrand. ↑ en ↓ gaan van kaart naar kaart."
          }
        }
      }
    },
    "A floating panel in the middle, like Spotlight, with cards in a grid. The arrows move in every direction.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein schwebendes Feld in der Mitte, wie Spotlight, mit Karten in einem Raster. Die Pfeiltasten bewegen in alle Richtungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un panel flotante en el centro, como Spotlight, con las tarjetas en una cuadrícula. Las flechas se mueven en todas las direcciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un panneau flottant au centre, comme Spotlight, avec les cartes en grille. Les flèches se déplacent dans toutes les directions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlightのように画面中央に浮かぶパネルで、カードをグリッドに並べます。矢印キーで上下左右に移動します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een zwevend paneel in het midden, zoals Spotlight, met kaarten in een raster. De pijltoetsen bewegen in alle richtingen."
          }
        }
      }
    },
    "A new version of %@ is available": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neue Version von %@ ist verfügbar"
