    "%@ could not open its history": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte den Verlauf nicht öffnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no ha podido abrir su historial"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'a pas pu ouvrir son historique"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は履歴を開けませんでした"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kon de geschiedenis niet openen"
          }
        }
      }
    },
    "%@ found %lld items from Maccy. Importing copies them; Maccy keeps its own history. You can also do this later in Settings.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ hat %lld Objekt aus Maccy gefunden. Beim Importieren wird es kopiert; Maccy behält seinen eigenen Verlauf. Dies ist auch später in den Einstellungen möglich."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ hat %lld Objekte aus Maccy gefunden. Beim Importieren werden sie kopiert; Maccy behält seinen eigenen Verlauf. Dies ist auch später in den Einstellungen möglich."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ found %lld item from Maccy. Importing copies it; Maccy keeps its own history. You can also do this later in Settings."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ found %lld items from Maccy. Importing copies them; Maccy keeps its own history. You can also do this later in Settings."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ ha encontrado %lld ítem de Maccy. Al importarlo se copia; Maccy conserva su propio historial. También puedes hacerlo más tarde en Ajustes."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ ha encontrado %lld ítems de Maccy. Al importarlos se copian; Maccy conserva su propio historial. También puedes hacerlo más tarde en Ajustes."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ a trouvé %lld élément de Maccy. L'importation le copie ; Maccy conserve son propre historique. Vous pouvez aussi le faire plus tard dans les Réglages."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ a trouvé %lld éléments de Maccy. L'importation les copie ; Maccy conserve son propre historique. Vous pouvez aussi le faire plus tard dans les Réglages."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@がMaccyの項目を%lld 件見つけました。読み込むとコピーされ、Maccyの履歴はそのまま残ります。この操作はあとで設定から行うこともできます。"
                }
              }
            }
          }
        },
        "nl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ heeft %lld onderdeel van Maccy gevonden. Importeren kopieert het; Maccy houdt zijn eigen geschiedenis. Je kunt dit ook later doen in Instellingen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ heeft %lld onderdelen van Maccy gevonden. Importeren kopieert ze; Maccy houdt zijn eigen geschiedenis. Je kunt dit ook later doen in Instellingen."
                }
              }
            }
          }
        }
      }
    },
    "%@ found %lld items in Paste. Importing copies them; Paste keeps its own history. Pinboards come along as pinboards.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ hat %2$lld Objekt in Paste gefunden. Beim Importieren wird es kopiert; Paste behält seinen eigenen Verlauf. Pinnwände kommen als Pinnwände mit."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ hat %2$lld Objekte in Paste gefunden. Beim Importieren werden sie kopiert; Paste behält seinen eigenen Verlauf. Pinnwände kommen als Pinnwände mit."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ found %2$lld item in Paste. Importing copies it; Paste keeps its own history. Pinboards come along as pinboards."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ found %2$lld items in Paste. Importing copies them; Paste keeps its own history. Pinboards come along as pinboards."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ ha encontrado %2$lld ítem en Paste. Importar lo copia; Paste conserva su propio historial. Los tableros se importan como tableros."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ ha encontrado %2$lld ítems en Paste. Importar los copia; Paste conserva su propio historial. Los tableros se importan como tableros."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ a trouvé %2$lld élément dans Paste. L'importation le copie ; Paste garde son propre historique. Les tableaux d'épingles sont repris tels quels."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ a trouvé %2$lld éléments dans Paste. L'importation les copie ; Paste garde son propre historique. Les tableaux d'épingles sont repris tels quels."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@はPasteで%2$lld 項目を見つけました。読み込むとコピーされ、Pasteの履歴はそのまま残ります。ピンボードはピンボードとして引き継がれます。"
                }
              }
            }
          }
        },
        "nl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ heeft %2$lld onderdeel in Paste gevonden. Importeren kopieert het; Paste houdt zijn eigen geschiedenis. Prikborden komen mee als prikborden."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ heeft %2$lld onderdelen in Paste gevonden. Importeren kopieert ze; Paste houdt zijn eigen geschiedenis. Prikborden komen mee als prikborden."
                }
              }
            }
          }
        }
      }
    },
    "%@ from %@, %@, %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aus %@, %@, %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ from %2$@, %3$@, %4$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de %@, %@, %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de %@, %@, %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@からの%1$@、%3$@、%4$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uit %@, %@, %@"
          }
        }
      }
    },
    "%@ has more than 2,000 items. Search may slow down.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ enthält mehr als 2.000 Objekte. Die Suche kann langsamer werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiene más de 2000 ítems. La búsqueda puede ir más lenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ contient plus de 2 000 éléments. La recherche peut ralentir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@には2,000件を超える項目があります。検索が遅くなる場合があります。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bevat meer dan 2.000 onderdelen. Zoeken kan trager worden."
          }
        }
      }
    },
    "%@ has no Dock or menu bar icon, so it adds itself to Login Items to be ready after a restart. macOS shows a notice when it does. Turn it off in Settings, General.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat kein Symbol im Dock oder in der Menüleiste und trägt sich deshalb in die Anmeldeobjekte ein, um nach einem Neustart bereit zu sein. macOS zeigt dabei einen Hinweis. Abschalten unter Einstellungen, Allgemein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tiene icono en el Dock ni en la barra de menús, así que se añade a los ítems de inicio para estar listo tras reiniciar. macOS muestra un aviso cuando lo hace. Desactívalo en Ajustes, General."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'a pas d'icône dans le Dock ni dans la barre des menus ; il s'ajoute donc aux éléments d'ouverture pour être prêt après un redémarrage. macOS affiche alors un avis. Désactivez-le dans Réglages, Général."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にはDockやメニューバーのアイコンがないため、再起動後もすぐ使えるようログイン項目に自身を追加します。その際macOSが通知を表示します。設定の「一般」でオフにできます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft geen icoon in het Dock of de menubalk en zet zichzelf daarom bij de inloglijst, zodat het na een herstart klaarstaat. macOS toont dan een melding. Uitzetten kan in Instellingen, Algemeen."
          }
        }
      }
    },
    "%@ has not crashed on this Mac, or macOS has already removed the log.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist auf diesem Mac nicht abgestürzt oder macOS hat das Protokoll bereits entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no ha fallado en este Mac, o macOS ya ha eliminado el registro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'a pas planté sur ce Mac, ou macOS a déjà supprimé le journal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はこのMacでクラッシュしていないか、macOSがすでにログを削除しています。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is niet gecrasht op deze Mac, of macOS heeft het logbestand al verwijderd."
          }
        }
      }
    },
    "%@ is also running. Two clipboard managers record every copy twice; consider turning one off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist ebenfalls aktiv. Zwei Zwischenablage-Manager zeichnen jede Kopie doppelt auf; es empfiehlt sich, einen davon zu deaktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ también se está ejecutando. Dos gestores de portapapeles registran cada copia dos veces; plantéate desactivar uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est également en cours d'exécution. Deux gestionnaires de presse-papiers enregistrent chaque copie deux fois ; envisagez d'en désactiver un."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@も実行中です。クリップボードマネージャが2つあると、すべてのコピーが二重に記録されます。どちらかをオフにすることを検討してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is ook actief. Twee klembordbeheerders leggen elke kopie twee keer vast; overweeg er een uit te schakelen."
          }
        }
      }
    },
    "%@ is available. You have %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist verfügbar. Installiert ist %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is available. You have %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión %@ está disponible. Tienes la %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version %@ est disponible. Vous avez la version %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン %@が利用可能です。現在のバージョンは%@です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is beschikbaar. Je hebt %@."
          }
        }
      }
    },
    "%@ is not recording copies. Allow it under Privacy & Security, Paste from Other Apps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zeichnet keine Kopien auf. Erlaube es unter Datenschutz & Sicherheit, „Aus anderen Apps einsetzen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no está guardando lo que copias. Permítelo en Privacidad y seguridad, Pegar desde otras apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'enregistre pas vos copies. Autorisez-le dans Confidentialité et sécurité, Coller depuis d'autres apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はコピーを記録していません。「プライバシーとセキュリティ」の「ほかのAppからペースト」で許可してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bewaart geen kopieën. Sta het toe bij Privacy en beveiliging, Plakken vanuit andere apps."
          }
        }
      }
    },
    "%@ is up to date.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist auf dem neuesten Stand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está actualizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est à jour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は最新です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is up-to-date."
          }
        }
      }
    },
    "%@ keeps running. Use the shortcut to open the shelf, or open %@ from Spotlight to get back here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ läuft weiter. Die Ablage lässt sich mit dem Kurzbefehl öffnen. Um hierher zurückzukehren, %@ über Spotlight öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ keeps running. Use the shortcut to open the shelf, or open %2$@ from Spotlight to get back here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sigue ejecutándose. Usa la función rápida para abrir el estante, o abre %@ desde Spotlight para volver aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ continue de fonctionner. Utilisez le raccourci pour ouvrir l'étagère, ou ouvrez %@ depuis Spotlight pour revenir ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は実行を続けます。ショートカットでシェルフを開くか、Spotlightから%@を開くとここに戻れます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ blijft actief. Gebruik de toetscombinatie om de plank te openen, of open %@ via Spotlight om hier terug te komen."
          }
        }
      }
    },
    "%@ keeps what you copy on a shelf at the bottom of the screen. Press the shortcut, arrow to a card, press Return, and it is pasted where you were typing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ legt alles Kopierte in einer Ablage am unteren Bildschirmrand ab. Kurzbefehl drücken, mit den Pfeiltasten eine Karte auswählen und den Zeilenschalter drücken – schon wird der Inhalt dort eingefügt, wo zuletzt getippt wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ guarda lo que copias en un estante en la parte inferior de la pantalla. Pulsa la función rápida, ve a una tarjeta con las flechas, pulsa Retorno y se pegará donde estabas escribiendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ conserve ce que vous copiez sur une étagère en bas de l'écran. Appuyez sur le raccourci, choisissez une carte avec les flèches, appuyez sur Retour, et elle est collée là où vous saisissiez du texte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はコピーしたものを画面下部のシェルフに保管します。ショートカットを押し、矢印キーでカードを選んでReturnキーを押すと、入力していた場所にペーストされます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bewaart wat je kopieert op een plank onder in het scherm. Druk op de toetscombinatie, ga met de pijltoetsen naar een kaart, druk op Return en het wordt geplakt waar je aan het typen was."
          }
        }
      }
    },
    "%@ keeps your history by reading the clipboard each time you copy. macOS asks first: choose Allow, or turn %@ on under Privacy & Security, Paste from Other Apps. Nothing leaves your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ führt deinen Verlauf, indem es bei jedem Kopieren die Zwischenablage liest. macOS fragt vorher: Wähle „Erlauben“ oder schalte %2$@ unter Datenschutz & Sicherheit, „Aus anderen Apps einsetzen“ ein. Nichts verlässt deinen Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ guarda tu historial leyendo el portapapeles cada vez que copias. macOS pregunta antes: elige Permitir o activa %2$@ en Privacidad y seguridad, Pegar desde otras apps. Nada sale de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tient votre historique en lisant le presse-papiers à chaque copie. macOS demande d'abord : choisissez Autoriser, ou activez %2$@ dans Confidentialité et sécurité, Coller depuis d'autres apps. Rien ne quitte votre Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はコピーするたびにクリップボードを読み込んで履歴を保存します。macOSが先に確認するので「許可」を選ぶか、「プライバシーとセキュリティ」の「ほかのAppからペースト」で%2$@をオンにしてください。データがMacの外に出ることはありません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ houdt je geschiedenis bij door bij elke kopie het klembord te lezen. macOS vraagt eerst toestemming: kies Sta toe, of zet %2$@ aan bij Privacy en beveiliging, Plakken vanuit andere apps. Er gaat niets van je Mac af."
          }
        }
      }
    },
    "%@ now runs without a menu bar icon and opens at login. Press %@ to open it; the icon is in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ läuft jetzt ohne Menüleistensymbol und startet beim Anmelden. %2$@ drücken, um es zu öffnen; das Symbol gibt es in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ now runs without a menu bar icon and opens at login. Press %2$@ to open it; the icon is in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ahora se ejecuta sin icono en la barra de menús y se abre al iniciar sesión. Pulsa %2$@ para abrirlo; el icono está en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ fonctionne désormais sans icône dans la barre des menus et s'ouvre à la connexion. Appuyez sur %2$@ pour l'ouvrir ; l'icône est dans les Réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はメニューバーのアイコンなしで動作し、ログイン時に起動するようになりました。%2$@を押すと開きます。アイコンは設定で有効にできます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ draait nu zonder menubalksymbool en start bij het inloggen. Druk op %2$@ om het te openen; het symbool staat in Instellingen."
          }
        }
      }
    },
    "%@ on GitHub": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ auf GitHub"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en GitHub"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sur GitHub"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubの%@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ op GitHub"
          }
        }
      }
    },
    "%@ runs in the background, with no Dock or menu bar icon, and opens at login. Press the shortcut anywhere to open the shelf; press it again, or Escape, to close it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ läuft im Hintergrund, ohne Symbol im Dock oder in der Menüleiste, und startet beim Anmelden. Den Kurzbefehl überall drücken, um die Ablage zu öffnen; zum Schließen erneut oder Esc drücken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se ejecuta en segundo plano, sin icono en el Dock ni en la barra de menús, y se abre al iniciar sesión. Pulsa la función rápida en cualquier lugar para abrir el estante; vuelve a pulsarla, o pulsa Esc, para cerrarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fonctionne en arrière-plan, sans icône dans le Dock ni dans la barre des menus, et s'ouvre à la connexion. Appuyez sur le raccourci n'importe où pour ouvrir l'étagère ; appuyez à nouveau, ou sur Échap, pour la fermer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はDockやメニューバーにアイコンを出さずにバックグラウンドで動作し、ログイン時に起動します。どこでもショートカットを押すとシェルフが開きます。もう一度押すか、Escキーを押すと閉じます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ draait op de achtergrond, zonder Dock- of menubalksymbool, en start bij het inloggen. Druk waar dan ook op de toetscombinatie om de plank te openen; druk er nogmaals op, of op Esc, om hem te sluiten."
          }
        }
      }
    },
