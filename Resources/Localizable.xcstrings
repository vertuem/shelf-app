    "Hold the plain text modifier while double-clicking a card or with the quick paste shortcut to paste without formatting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Einfügen ohne Formatierung beim Doppelklicken auf eine Karte oder zusammen mit dem Kurzbefehl für schnelles Einfügen die Sondertaste für reinen Text gedrückt halten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la tecla modificadora de texto sin formato al hacer doble clic en una tarjeta o al usar la función rápida de pegado rápido para pegar sin formato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez la touche de modification pour texte brut enfoncée en double-cliquant sur une carte ou avec le raccourci de collage rapide pour coller sans mise en forme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードをダブルクリックするときや、クイックペーストのショートカットを使うときにプレーンテキスト修飾キーを押したままにすると、書式なしでペーストできます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de toets voor platte tekst ingedrukt terwijl je dubbelklikt op een kaart of de toetscombinatie voor snel plakken gebruikt om zonder opmaak te plakken."
          }
        }
      }
    },
