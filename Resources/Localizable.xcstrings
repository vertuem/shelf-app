    "Updates": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizaciones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mises à jour"
          }
        },
