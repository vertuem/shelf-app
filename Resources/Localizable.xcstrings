    "Install the newer version again, or back up the history and start with an empty one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neuere Version erneut installieren oder den Verlauf sichern und mit einem leeren Verlauf beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a instalar la versión más reciente, o haz una copia de seguridad del historial y empieza con uno vacío."
