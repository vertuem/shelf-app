    "“%@” and its %lld items will be deleted. Items that are still in your history stay there.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "„%@“ und %lld enthaltenes Objekt werden gelöscht. Objekte, die sich noch im Verlauf befinden, bleiben dort erhalten."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "„%@“ und %lld enthaltene Objekte werden gelöscht. Objekte, die sich noch im Verlauf befinden, bleiben dort erhalten."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%@” and its %lld item will be deleted. Items that are still in your history stay there."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%@” and its %lld items will be deleted. Items that are still in your history stay there."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Se eliminarán «%@» y su %lld ítem. Los ítems que sigan en tu historial permanecerán allí."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Se eliminarán «%@» y sus %lld ítems. Los ítems que sigan en tu historial permanecerán allí."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "« %@ » et son élément (%lld) seront supprimés. Les éléments encore présents dans votre historique y resteront."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "« %@ » et ses %lld éléments seront supprimés. Les éléments encore présents dans votre historique y resteront."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%@”とその%lld 項目は削除されます。履歴に残っている項目はそのまま残ります。"
                }
              }
            }
          }
        },
        "nl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "‘%@’ en %lld onderdeel daarin worden verwijderd. Onderdelen die nog in je geschiedenis staan, blijven daar."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "‘%@’ en de %lld onderdelen daarin worden verwijderd. Onderdelen die nog in je geschiedenis staan, blijven daar."
                }
              }
            }
          }
        }
      }
    },
