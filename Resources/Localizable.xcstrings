    "The download does not match the published checksum.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download stimmt nicht mit der veröffentlichten Prüfsumme überein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga no coincide con la suma de verificación publicada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement ne correspond pas à la somme de contrôle publiée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたファイルが公開されているチェックサムと一致しません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
