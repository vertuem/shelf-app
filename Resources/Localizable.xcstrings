    "Still to do: %@. Go Back, or later in Settings, General.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch offen: %@. Gehe zurück oder später in Einstellungen, Allgemein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendiente: %@. Vuelve atrás, o más tarde en Ajustes, General."
